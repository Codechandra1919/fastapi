@startuml Komponenten

left to right direction

actor RESTClient
actor GraphQLClient

node "mieter" {
  [mieter_router]
  [mieter_write_router]
  [schema]

  [mieter_read_service]
  [mieter_write_service]

  [mieter_repository]

  [mailer]
}


cloud {
    [SQLAlchemy]
}

cloud {
    [smtp]
}

database "DB mieter" {
    [Tabelle mieter]
    [Tabelle mietvertrag]
    [Tabelle mietrechnung]
}

node {
    [Mailserver]
}

RESTClient ~~> [mieter_router]
RESTClient ~~> [mieter_write_router]
GraphQLClient ~~> [schema]

[mieter_router] ..> [mieter_read_service]
[mieter_write_router] ..> [mieter_write_service]
[schema] ..> [mieter_read_service]
[schema] ..> [mieter_write_service]
[mieter_read_service] ..> [mieter_repository]
[mieter_write_service] ..> [mieter_repository]

[mieter_repository] ~~> [SQLAlchemy]
[SQLAlchemy] ~~> [Tabelle mieter]
[SQLAlchemy] ~~> [Tabelle mietvertrag]
[SQLAlchemy] ~~> [Tabelle mietrechnung]

[mieter_write_service] ..> [mailer]
[mailer] ~~> [smtp]
[smtp] ~~> [Mailserver]

footer (c) Jürgen Zimmermann

@enduml
