' Preview durch <Alt>d

@startuml ER Diagramm

' hide the spot
hide circle

' evtl. Prbleme mit Kraehenfuessen vermeiden
skinparam linetype ortho

entity "Mieter" {
  * id : integer <<generated>>
  --
  * version: integer
  * nachname : text
  * email : text <<unique>>
  * telefonnummer: text
  * geburtsdatum: date
  * username: text <<FK>>
  * erzeugt: timestamp
  * aktualisiert: timestamp
}

entity "Mietvertrag" {
  * id : integer <<generated>>
  --
  * seiten_anz : integer
  * kaution : decimal
  * **mieter_id**: integer <<FK>>
}

entity "Mietrechnung" {
  * id : integer <<generated>>
  --
  * betrag : decimal
  * waehrung : text
  * **mieter_id**: integer <<FK>>
}

Mieter ||.left.|| Mietvertrag
Mieter ||..o{ Mietrechnung

footer (c) Juergen Zimmermann

@enduml

