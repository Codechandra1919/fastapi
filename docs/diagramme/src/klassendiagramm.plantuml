@startuml Klassendiagramm

skinparam classAttributeIconSize 0
skinparam linetype ortho

package "Entitäten" {
  abstract class Base

  class Patient {
    id: int
    version: int
    nachname: str
    email: str
    kategorie: int
    has_newsletter: bool
    geburtsdatum: date
    homepage: str [0..1]
    username: str [0..1]
    erzeugt: datetime [0..1]
    aktualisiert: datetime [0..1]
    fachaerzte: list<Facharzt>
    --
    set(patient: Patient): None
  }

  class Adresse {
    id: int
    plz: str
    ort: str
  }

  class Rechnung {
    id: int
    betrag: Decimal
    waehrung: str
  }

  enum Geschlecht
  enum Familienstand
  enum Facharzt
}

package "Anwendungsschicht" {
  class PatientService {
    --
    find_by_id(id: int, user: User): PatientDTO
    find(...): Slice<PatientDTO>
    find_nachnamen(teil: str): Sequence<str>
  }

  class PatientWriteService {
    --
    create(patient: Patient): PatientDTO
    update(patient: Patient, id: int, version: int): PatientDTO
    delete_by_id(id: int): None
  }

  class PatientRepository {
    --
    find_by_id(id: int, session: Session): Patient
    find(...): Slice<Patient>
    create(patient: Patient, session: Session): Patient
    update(patient: Patient, session: Session): Patient
    delete_by_id(id: int, session: Session): None
  }

  class UserService
}

package "DTOs" {
  class PatientDTO {
    id: int
    version: int
    nachname: str
    email: str
    kategorie: int
    has_newsletter: bool
    geburtsdatum: date
    homepage: str [0..1]
    username: str [0..1]
    fachaerzte: list<Facharzt>
    --
    from_patient(patient: Patient): PatientDTO
  }

  class AdresseDTO {
    plz: str
    ort: str
    --
    from_adresse(adresse: Adresse): AdresseDTO
  }

  class Slice<T> {
    content: tuple<T>
    total_elements: int
  }
}

Patient --|> Base
Adresse --|> Base
Rechnung --|> Base

Patient "1" -- "0..1" Adresse : adresse
Patient "1" -- "0..*" Rechnung : rechnungen
Patient --> Geschlecht
Patient --> Familienstand
Patient --> Facharzt

PatientService --> PatientRepository
PatientWriteService --> PatientRepository
PatientWriteService --> UserService
PatientService ..> PatientDTO
PatientWriteService ..> PatientDTO
PatientRepository ..> Patient
PatientDTO ..> Patient : from_patient()
PatientDTO *-- AdresseDTO : adresse
AdresseDTO ..> Adresse : from_adresse()
PatientService ..> Slice
PatientRepository ..> Slice

footer (c) Jürgen Zimmermann

@enduml
