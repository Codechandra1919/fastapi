' Preview durch <Alt>d

@startuml Schichtenarchitektur

package mieter #DDDDDD {
    package rest #FFFFFF {
        [@router.get()\nget_by_id()\n\n@router.get()\nget()\n\n@router.get()\nget_nachnamen()] as MieterGetController
        [@router.post()\npost()\n\n@router.put()\nput()\n\n@router.delete()\ndelete_by_id()] as MieterWriteController
        [@router.get()\nliveness()\n\n@router.get()\nreadiness()] as HealthController

        [MieterGetController] -right[hidden]-> [MieterWriteController]
    }

    package service #FFFFFF {
        [find_by_id()\nfind()\nfind_nachnamen()] as MieterReadService
        [create()\nupdate()\ndelete()] as MieterWriteService
    }

    [MieterGetController] --> [MieterReadService]
    [MieterWriteController] --> [MieterWriteService]

    package repository #FFFFFF {
        [find_by_id()\nfind()\nexists_email()\nfind_nachnamen()\ncreate()\nupdate()\ndelete_by_id()\ncheck_db_connection()] as MieterRepository
    }

    [MieterReadService] --> [MieterRepository]
    [MieterWriteService] --> [MieterRepository]
    [HealthController] --> [MieterRepository]

    package entity #FFFFFF {
        [Mieter]
        [Mietvertrag]
        [Mietrechnung]

        [Mieter] -right[hidden]-> [Mietvertrag]
        [Mietvertrag] -down[hidden]-> [Mietrechnung]
    }

    [MieterGetController] ..> [Mieter]
    [MieterWriteController] ..> [Mieter]
    [MieterReadService] .left.> [Mieter]
    [MieterWriteService] ..> [Mieter]
    [MieterRepository] ..> [Mieter]
}

RESTClient ~~> [MieterGetController]
RESTClient ~~> [MieterWriteController]
RESTClient ~~> [HealthController]

cloud {
    [SQLAlchemy\n(OR-Mapping)] as SQLAlchemy
}

[MieterRepository] ~down~> [SQLAlchemy]
entity ~~> [SQLAlchemy]

database "DB mieter" as db {
    [Tabelle mieter]
    [Tabelle mietvertrag]
    [Tabelle mietrechnung]
}

[SQLAlchemy] ~down~> db

footer (c) Juergen Zimmermann

@enduml
